# Fires once, on the date the photos are due to go.
#
# cc2026 ends on 11 October 2026, so the photos go on 11 January 2027. The
# script checks this against the exhibition's own end date and refuses to run
# early, so a mistake here costs a failed unit rather than an exhibition's
# photos.

[Unit]
Description=Delete visitor photos three months after the exhibition

[Timer]
OnCalendar=2027-01-11 04:00:00

# The machine will not necessarily be running that morning. Persistent makes it
# catch up at the next boot instead of skipping the date it was meant to fire.
Persistent=true

[Install]
WantedBy=timers.target
